{
  "name": "bass-practice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "本地五弦贝斯练习工具：音级地图、33种音阶、调式转换与Jam。",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/bass-practice/server.cjs",
    "check": "tsc --noEmit",
    "test": "node tests/scale-library.cjs && node tests/practice.cjs && node tests/audio.cjs && node tests/server.cjs",
    "package:windows": "node scripts/package-windows.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "radix-ui": "1.6.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "esbuild": "0.28.0",
    "@vitejs/plugin-react": "6.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
