{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {"@/*": ["./*"]},
    "types": ["node"]
  },
  "include": ["main.tsx", "app/**/*.tsx", "components/**/*.tsx", "lib/**/*.ts"],
  "exclude": ["node_modules", "dist", "release"]
}
